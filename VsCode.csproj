<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Сервер жалуется на 250 МБ RSS - это почти наверняка НЕ утечка (проверил основные
      ConcurrentDictionary в StaticClasses/UserService - Users/PlayersStatus/EventSenders/
      UserServices/Lobbies корректно чистятся в ForceDisconnect), а Server GC. .NET по
      умолчанию на многоядерной машине включает Server GC, который резервирует отдельный
      сегмент кучи НА КАЖДОЕ ЯДРО ради throughput - для консольного TCP/UDP/HTTP-сервиса
      (I/O-bound, не CPU-bound) это чистый оверхед в памяти без реальной пользы.
      Workstation GC даёт тот же функционал при заметно меньшем базовом footprint.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.Core" Version="3.7.107.9" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="3.7.103.16" />
    <PackageReference Include="DnsClient" Version="1.7.0" />
    <PackageReference Include="Google.Apis" Version="1.61.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.61.0" />
    <PackageReference Include="Google.Apis.Core" Version="1.61.0" />
    <PackageReference Include="Google.Apis.Oauth2.v2" Version="1.61.0.1869" />
    <PackageReference Include="Google.Protobuf" Version="3.2.0" />
    <PackageReference Include="MongoDB.Driver" Version="2.21.0" />
    <PackageReference Include="Telegram.Bot" Version="22.9.0" />
  </ItemGroup>

